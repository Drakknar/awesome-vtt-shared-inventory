<li class="avtsi-item">
  <div class="avtsi-item-row">
    <button type="button" data-avtsi-action="details" data-item-id="{{id}}" class="avtsi-item-name {{#if details}}active{{/if}}"
            aria-expanded="{{#if details}}true{{else}}false{{/if}}">
      <img src="{{img}}" alt=""><span>{{name}}</span>
    </button>
    {{#if @root.canEdit}}
    <span class="avtsi-qty">
      <button type="button" data-avtsi-action="qty" data-item-id="{{id}}" data-delta="-1" data-tooltip="" aria-label="{{localize 'AVTTSI.Less'}}">−</button>
      <span>{{quantity}}</span>
      <button type="button" data-avtsi-action="qty" data-item-id="{{id}}" data-delta="1" data-tooltip="" aria-label="{{localize 'AVTTSI.More'}}">+</button>
    </span>
    {{#if @root.actor}}
    <button type="button" data-avtsi-action="take" data-item-id="{{id}}" data-tooltip="" aria-label="{{localize 'AVTTSI.Take' name=@root.actor.name}}">
      <i class="fa-solid fa-hand-holding" inert></i>
    </button>
    {{/if}}
    {{#if @root.isGM}}
    <button type="button" data-avtsi-action="edit" data-item-id="{{id}}" data-tooltip="" aria-label="{{localize 'AVTTSI.Edit'}}">
      <i class="fa-solid fa-pen-to-square" inert></i>
    </button>
    {{/if}}
    <button type="button" data-avtsi-action="remove" data-item-id="{{id}}" data-tooltip="" aria-label="{{localize 'AVTTSI.Remove'}}">
      <i class="fa-solid fa-trash" inert></i>
    </button>
    {{else}}
    <span class="avtsi-qty"><span>×{{quantity}}</span></span>
    {{/if}}
  </div>
  {{#if details}}<div class="avtsi-details">{{{details}}}</div>{{/if}}
  {{#if contents.length}}
  <ul class="avtsi-items avtsi-contents">{{#each contents}}{{> avtsiItem}}{{/each}}</ul>
  {{/if}}
</li>
